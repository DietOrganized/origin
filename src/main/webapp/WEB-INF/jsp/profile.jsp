<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<% request.setAttribute("activePage", "profile"); request.setAttribute("pageLabel", "个人目标"); request.setAttribute("pageTitle", "你的目标，你的节奏"); request.setAttribute("pageSubtitle", "完善个人资料，制定适合自己的热量计划。"); %>
<%@ include file="fragments/header.jspf" %>
<div class="grid two"><section class="card"><h2>个人资料与饮食目标</h2><div class="form-grid"><label>性别<select disabled><option>暂不设置</option><option>男</option><option>女</option></select></label><label>出生日期<input type="date" placeholder="" disabled></label><label>身高 / cm<input type="number" placeholder="" disabled></label><label>当前体重 / kg<input type="number" placeholder="" disabled></label><label>目标体重 / kg<input type="number" placeholder="" disabled></label><label>当前目标<select disabled><option>保持体重</option><option>减脂</option><option>增肌</option></select></label><label>活动水平<select disabled><option>久坐</option><option>轻度</option><option>中度</option><option>高度</option><option>极高</option></select></label><label>热量目标方式<select disabled><option>自动计算</option><option>手动设置</option></select></label><label>每日目标 / kcal<input type="number" placeholder="" disabled></label></div><div class="form-actions"><button class="primary" data-login>登录并完善资料</button></div></section><section class="card"><h2>我的能量计划</h2><div class="meal-row spaced"><span>基础代谢 BMR</span><strong>— <span class="unit">kcal</span></strong></div><div class="meal-row spaced"><span>每日总消耗 TDEE</span><strong>— <span class="unit">kcal</span></strong></div><div class="meal-row spaced"><span>每日热量目标</span><strong>— <span class="unit">kcal</span></strong></div><div class="tip">自动模式根据身高、体重、年龄和活动水平计算；也可以手动指定每日目标。</div></section></div>
